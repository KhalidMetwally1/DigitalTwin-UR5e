  <dc:creator>The contributors of MQTTnet</dc:creator>
  <dc:description>MQTTnet is a high performance .NET library for MQTT based communication. It provides a MQTT client and a MQTT server (broker) and supports v3.1.0, v3.1.1 and v5.0.0 of the MQTT protocol.</dc:description>
  <dc:identifier>MQTTnet</dc:identifier>
  <version>5.1.0.1559</version>
